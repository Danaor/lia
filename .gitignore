# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
*.spec

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log

# Config (user-specific, has device indices)
# config.json is in AppData, not tracked here

# Large media files
*.mp4
*.mp3
*.wav
*.m4a

# Auto-generated launcher (a copy of pythonw.exe so Task Manager shows
# 'Lia.exe'). Created on first run, no reason to commit. Pre-rebrand names
# are listed too: an existing working copy still has them on disk.
Lia.exe
Recap.exe
WhisperType.exe

# Inno Setup installer output (large; built artifact, not source)
installer_output/

# Full-runtime distribution assembled by build_runtime.py (CPython embeddable +
# sources, ~76MB). Build artifact, never source - build_runtime.py IS the source.
lia/build_runtime/

# Windows version resource, generated by build.py on every build
version_info.txt

# Local speaker-diarization weights (pyannote HF cache; downloaded artifact,
# not source). Produced by "Download diarization model" /
# diarize_local.py --download; bundle it at packaging time to ship an offline,
# token-free product.
diarization_models/

# Shipped HuggingFace token FALLBACK for local diarization (bundled_hf_token()).
# NEVER commit - this repo is public; a committed HF token gets auto-revoked by
# GitHub/HF secret scanning. Included in distribution builds, never in source.
hf_token.local

# Portable-build config seed (bundled_seed_config()). Sits next to lia.py in
# the PORTABLE distribution only, giving it opinionated first-run defaults.
# Kept OUT of source so the main installer / dev runs stay keyless-local. May
# contain an API key in some distributions -> gitignored like hf_token.local.
# Never commit.
config.seed.json

# Logo/brand-artwork iteration drafts (e.g. lia-edited.png, lia-highlighted.png,
# lia-shape-centered.png). The master artwork lia.png (no hyphen suffix) stays
# tracked; these hyphenated drafts never do.
lia/lia-*.png

# Design-iteration leftovers (the retired drawn-logo experiment's previews)
_lia_logo/
_*.py
_*.html
_*.json
_*.txt

# Logo/icon exploration drafts. The 6 tray STATE icons (tray_idle, tray_error,
# tray_loading, tray_meeting, tray_processing, tray_recording) are real source
# and stay tracked; everything else in here is a discarded brand draft.
lia/tray_icons/*
!lia/tray_icons/tray_idle.png
!lia/tray_icons/tray_error.png
!lia/tray_icons/tray_loading.png
!lia/tray_icons/tray_meeting.png
!lia/tray_icons/tray_processing.png
!lia/tray_icons/tray_recording.png

# Personal / working-tree files that must never reach a public repo:
# real meeting transcripts, exported summaries, scratch recordings.
*_meeting.txt
*_meeting_diarized.txt
*_meeting_summary.html

# Claude scratch (never versioned anywhere)
.claude/

# Historical design-exploration output kept on disk only (waveform/icon
# previews and superseded logo drafts). The live brand is generated by
# lia/generate_logo.py.
_wave_preview/
recap.png
recap logo.png
